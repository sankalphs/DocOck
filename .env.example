# Copy to .env and fill in. Never commit .env.
# `scripts/up.ps1` creates it from this file on first run.

# --- DocOck services --------------------------------------------------------
ENVIRONMENT=local
API_HOST=127.0.0.1
API_PORT=8001
DASHBOARD_PORT=3001

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# json (default) writes one line per event; console is for interactive debugging.
LOG_FORMAT=json

# --- Postgres + pgvector ----------------------------------------------------
POSTGRES_USER=docock
POSTGRES_PASSWORD=docock
POSTGRES_DB=docock
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://docock:docock@127.0.0.1:5433/docock

# --- Demo / telemetry endpoints (host-published ports) ----------------------
DEMO_FRONTEND_URL=http://127.0.0.1:8080
PROMETHEUS_URL=http://127.0.0.1:9090
JAEGER_URL=http://127.0.0.1:16686
# Jaeger v2 serves its query API under <base_path>/api/v3/*, e.g.
# http://127.0.0.1:16686/jaeger/ui/api/v3/services
JAEGER_BASE_PATH=/jaeger/ui
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=otel-logs*
FLAGD_URL=http://127.0.0.1:8013
FLAGD_OFREP_URL=http://127.0.0.1:8016
DEMO_COMPOSE_PROJECT=docock-demo
# The demo's compose network name; a container must be on exactly this network
# before the fault controller will touch it.
DEMO_NETWORK=opentelemetry-demo
LOAD_GENERATOR_URL=http://127.0.0.1:8089

# --- Reasoning model --------------------------------------------------------
# stub | zenmux | openai_compatible. `stub` is the offline default: no key, no
# network, deterministic. To use ZenMux set LLM_PROVIDER=zenmux and LLM_API_KEY.
# Swapping provider is configuration only (or PATCH /api/settings/models).
# Base URLs and keys are .env-only; the runtime PATCH cannot change them.
LLM_PROVIDER=stub
LLM_BASE_URL=https://zenmux.ai/api/v1
LLM_MODEL=meta/muse-spark-1.3-contributor
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOOL_CALLS=20
# Per request; the whole investigation is bounded by AGENT_WALL_CLOCK_S.
LLM_TIMEOUT_S=90
LLM_RETRIES=2
LLM_MAX_TOKENS=1500
LLM_JSON_MODE=true
# USD per million tokens, used for local cost accounting.
LLM_PRICE_INPUT_PER_M=0.10
LLM_PRICE_OUTPUT_PER_M=0.20
LLM_DAILY_BUDGET_USD=2.00

# --- Embeddings -------------------------------------------------------------
# onnx_local | remote | stub. onnx_local downloads the int8 ONNX export
# (~614 MB) into runtime/models/ on first use; CPU only.
EMBEDDING_PROVIDER=onnx_local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ONNX_REPO=onnx-community/Qwen3-Embedding-0.6B-ONNX
EMBEDDING_ONNX_FILE=onnx/model_int8.onnx
EMBEDDING_ALLOW_DOWNLOAD=true
EMBEDDING_BATCH_SIZE=8
EMBEDDING_THREADS=4
# Only for EMBEDDING_PROVIDER=remote (OpenAI-compatible /embeddings).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Retrieval & agent ------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.55
AGENT_CONFIDENCE_THRESHOLD=0.70
AGENT_AUTO_REMEDIATE=false
AGENT_WALL_CLOCK_S=90

# --- Detection --------------------------------------------------------------
# The collector flushes span metrics every 10 s, so 10 s is the finest cadence
# that can see a new sample; three consecutive breaches still debounce.
DETECTOR_ENABLED=true
DETECTOR_INTERVAL_S=10
DETECTOR_WINDOW=2m
DETECTOR_BASELINE_WINDOW_S=900
DETECTOR_CONSECUTIVE_BREACHES=3
DETECTOR_LATENCY_BREACHES=9
DETECTOR_RECOVERY_SAMPLES=4
# One failed request in a low-traffic service is not an incident.
DETECTOR_MIN_ERRORS=2
DETECTOR_ERROR_RATE_FLOOR=0.02
DETECTOR_ERROR_RATE_MULTIPLIER=3.0
DETECTOR_LATENCY_MULTIPLIER=2.0
DETECTOR_LATENCY_FLOOR_MS=500
DETECTOR_COOLDOWN_S=300

# --- Faults -----------------------------------------------------------------
FAULT_DEFAULT_TTL_S=900
FAULT_MAX_TTL_S=3600
# The observer promotes PROPAGATING faults once the service shows the symptom;
# the demo's flagd SDK clients take 30-45 s, so this is not a no-op.
FAULT_PROBE_WINDOW=2m
FAULT_OBSERVER_INTERVAL_S=5
# The watchdog reverts expired faults even across an API restart (startup
# reconciliation reads the faults table).
FAULT_WATCHDOG_ENABLED=true
FAULT_WATCHDOG_INTERVAL_S=2
FAULT_REVERT_TIMEOUT_S=30
# Optional overrides; defaults are absolute under <repo>/runtime/.
# FAULT_AUDIT_FILE=runtime/audit/faults.jsonl
# FLAGD_FLAGS_FILE=runtime/flagd/demo.flagd.json

# --- Hardening ---------------------------------------------------------------
# Per-client limits on write endpoints (app/ratelimit.py); reads are never limited.
RATE_LIMIT_ENABLED=true
